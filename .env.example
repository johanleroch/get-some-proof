# Created by `pnpm dev:convex` for a local development deployment.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public origin used by authentication redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Turnstile widget key. Localhost falls back to Cloudflare's visible,
# always-pass test key; deployed environments must set a real widget key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set these on the Convex deployment, not in a public client variable.
# Localhost uses Cloudflare's matching test secret when TURNSTILE_SECRET is
# absent. A deployed environment must set both values and fail closed otherwise.
# `pnpm exec convex env set TURNSTILE_SECRET`
# `pnpm exec convex env set TURNSTILE_HOSTNAMES proof.example`

# Server-only proof shared with the Convex development deployment for the
# Public Wall and Embedded Wall server reads. Generate at least 32 random characters and set
# the same value with `pnpm exec convex env set PUBLIC_READ_RATE_LIMIT_SECRET`.
PUBLIC_READ_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional origin lock after a trusted gateway is configured. Leave UNSET for
# direct Next.js hosting. See docs/public-wall-boundary.md before enabling.
# PUBLIC_WALL_ORIGIN_GATEWAY_SECRET=replace-with-a-separate-random-secret

# Server-only Mux webhook signing secret from the Mux development webhook.
MUX_WEBHOOK_SECRET=replace-with-mux-webhook-signing-secret

# Server-only proof shared with the Convex development deployment so the
# verified Next.js webhook route can forward events to Convex. Generate at
# least 32 random characters and set the same value with
# `pnpm exec convex env set VIDEO_WEBHOOK_INGEST_SECRET`.
VIDEO_WEBHOOK_INGEST_SECRET=replace-with-at-least-32-random-characters

# Optional dedicated HMAC secret for durable management-link delivery. It is
# stored only in Convex; BETTER_AUTH_SECRET is the development fallback.
# `pnpm exec convex env set MANAGEMENT_LINK_TOKEN_SECRET`.
MANAGEMENT_LINK_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Authentication and email secrets belong to the Convex deployment environment,
# not this Next.js environment file. MUX_PROVIDER, MUX_TOKEN_ID, and
# MUX_TOKEN_SECRET also belong to Convex. See README.md.
