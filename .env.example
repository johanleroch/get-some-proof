# Next.js environment: copy to .env.local for development.
# In production, configure these variables in Vercel (Production scope), then
# rebuild. NEXT_PUBLIC_* values are public and embedded at build time.
# Created by `pnpm dev:convex` for a local development deployment.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public origin used by authentication redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://www.getsomeproof.com; must match Convex SITE_URL.
# .env is this checkout's production reference; .env.local overrides it locally.
# Editing either file does not update Vercel's environment variables.

# MCP/OAuth rollout: set true in BOTH the Next.js server environment and
# its matching Convex deployment to enable connections. Never NEXT_PUBLIC_*.
# Missing/false hides OAuth discovery and registration; the UI's Pro status
# does not enable the server. See docs/mcp-oauth-connection.md.
CHATGPT_IMPORT_ENABLED=false

# Google OAuth runs in Convex via the Next.js /api/auth proxy.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET belong ONLY in .env.convex.local
# (local) and .env.convex (production), then on the matching Convex deployment.
# Do not add Google credentials here, in Vercel, or as NEXT_PUBLIC_* variables.
# Google Cloud origins: http://localhost:3000 and https://www.getsomeproof.com.
# Redirect URIs: append /api/auth/callback/google to each origin.
# Full setup, JSON field mapping and verification: docs/deployment.md, section 4.

# Vercel Production only: complete deploy key from Convex Production Settings,
# with deployment:deploy permission. Never expose this as NEXT_PUBLIC_*.
# CONVEX_DEPLOY_KEY=replace-with-production-deploy-key
# Build command: pnpm exec convex deploy --cmd 'pnpm build'

# Public Turnstile widget key. Localhost falls back to Cloudflare's visible,
# always-pass test key; deployed environments must set a real widget key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set these on the Convex deployment, not in a public client variable.
# Localhost uses Cloudflare's matching test secret when TURNSTILE_SECRET is
# absent. A deployed environment must set both values and fail closed otherwise.
# `pnpm exec convex env set TURNSTILE_SECRET`
# `pnpm exec convex env set TURNSTILE_HOSTNAMES proof.example`

# Server-only proof shared with the Convex development deployment for the
# Public Wall and Embedded Wall server reads. Generate at least 32 random characters and set
# the same value with `pnpm exec convex env set PUBLIC_READ_RATE_LIMIT_SECRET`.
PUBLIC_READ_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional origin lock after a trusted gateway is configured. Leave UNSET for
# direct Next.js hosting. See docs/public-wall-boundary.md before enabling.
# PUBLIC_WALL_ORIGIN_GATEWAY_SECRET=replace-with-a-separate-random-secret

# Only needed here when Mux calls Next.js /api/mux/webhook. For the direct
# Convex /mux/webhook endpoint, keep both Mux webhook secrets in Convex only.
# Must match the signing secret of the configured Mux endpoint.
MUX_WEBHOOK_SECRET=replace-with-mux-webhook-signing-secret

# Server-only proof shared with the Convex development deployment so the
# verified Next.js webhook route can forward events to Convex. Generate at
# least 32 random characters and set the same value with
# `pnpm exec convex env set VIDEO_WEBHOOK_INGEST_SECRET`.
VIDEO_WEBHOOK_INGEST_SECRET=replace-with-at-least-32-random-characters

# Authentication and email secrets belong to the Convex deployment environment,
# not this Next.js environment file. MUX_PROVIDER, MUX_TOKEN_ID, and
# MUX_TOKEN_SECRET also belong to Convex. See README.md.
