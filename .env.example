# Created by `pnpm dev:convex` for a local development deployment.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public origin used by authentication redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only proof shared with the Convex development deployment for the
# Embedded Wall read limiter. Generate at least 32 random characters and set
# the same value with `pnpm exec convex env set PUBLIC_READ_RATE_LIMIT_SECRET`.
PUBLIC_READ_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Server-only Mux webhook signing secret from the Mux development webhook.
MUX_WEBHOOK_SECRET=replace-with-mux-webhook-signing-secret

# Server-only proof shared with the Convex development deployment so the
# verified Next.js webhook route can forward events to Convex. Generate at
# least 32 random characters and set the same value with
# `pnpm exec convex env set VIDEO_WEBHOOK_INGEST_SECRET`.
VIDEO_WEBHOOK_INGEST_SECRET=replace-with-at-least-32-random-characters

# Authentication and email secrets belong to the Convex deployment environment,
# not this Next.js environment file. MUX_PROVIDER, MUX_TOKEN_ID, and
# MUX_TOKEN_SECRET also belong to Convex. See README.md.
