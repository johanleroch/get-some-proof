# Convex server environment. Copy to .env.convex.local for local development
# or .env.convex for production (both ignored by Git). Replace all placeholders
# and remove unused optional values before importing. Never import this example.
# Local: pnpm exec convex dashboard --deployment local --no-open
# Then: pnpm exec convex env set --deployment local --from-file .env.convex.local --force
# Production: confirm the target first with:
# pnpm exec convex dashboard --prod --no-open
# Then: pnpm exec convex env set --prod --from-file .env.convex --force
# This sets variables only; it does not deploy functions.
# Never put CONVEX_DEPLOY_KEY or CONVEX_DEPLOYMENT in this import file.

# Authentication: match NEXT_PUBLIC_SITE_URL in the Next.js environment.
# Production: https://www.getsomeproof.com (same canonical domain as Next.js).
SITE_URL=http://localhost:3000
# Generate a different secret per environment, e.g. openssl rand -hex 32.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Email: console is local-only. Production requires EMAIL_PROVIDER=resend,
# a Resend API key with Sending access for the verified sending domain,
# and an EMAIL_FROM address on that domain. No Resend key is needed in Vercel.
EMAIL_PROVIDER=console
# RESEND_API_KEY=replace-with-resend-api-key
# EMAIL_FROM=Get Some Proof <noreply@getsomeproof.com>

# Cloudflare Turnstile: required on non-local sites. The corresponding public
# NEXT_PUBLIC_TURNSTILE_SITE_KEY belongs in Next.js/Vercel.
# TURNSTILE_SECRET=replace-with-turnstile-secret
# Comma-separated hostnames, without protocol; defaults to SITE_URL hostname.
# TURNSTILE_HOSTNAMES=getsomeproof.com,www.getsomeproof.com

# Embedded Wall limiter: use the same random value in Next.js/Vercel.
PUBLIC_READ_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional dedicated management-link delivery secret; otherwise falls back to
# BETTER_AUTH_SECRET. Convex only.
# MANAGEMENT_LINK_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Google sign-in: both credentials are required to enable the provider.
# Google Cloud > Google Auth Platform > Clients > Web application.
# Client name: Get Some Proof - Web. Downloaded JSON fields:
# web.client_id -> GOOGLE_CLIENT_ID; web.client_secret -> GOOGLE_CLIENT_SECRET.
# Store only in this environment's real file and Convex, never Next.js/Vercel.
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://www.getsomeproof.com
# Authorized redirect URIs (website URLs, NOT *.convex.site URLs):
#   http://localhost:3000/api/auth/callback/google
#   https://www.getsomeproof.com/api/auth/callback/google
# Register each environment used by this client; both can share this web client.
# See docs/deployment.md section 4 for import and verification instructions.
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional Stripe Billing: configure separately after the documented rehearsal.
# Use test keys in development; live activation is a separate production step.
# STRIPE_SECRET_KEY=replace-with-stripe-test-secret-key
# STRIPE_WEBHOOK_SECRET=replace-with-stripe-test-webhook-signing-secret

# Use `fake` for local simulation or `mux` for real Mux development uploads.
MUX_PROVIDER=mux

# Create a Mux Video access token with Read and Write permissions.
MUX_TOKEN_ID=replace-with-mux-token-id
MUX_TOKEN_SECRET=replace-with-mux-token-secret

# Signing secret generated by the Mux webhook configured to call this Convex
# deployment's https://<deployment>.convex.site/mux/webhook endpoint.
MUX_WEBHOOK_SECRET=replace-with-mux-webhook-signing-secret

# Generate at least 32 random characters. Both webhook paths use this server-only
# secret to derive reproducible Video Retry Link tokens after Mux failures.
VIDEO_WEBHOOK_INGEST_SECRET=replace-with-at-least-32-random-characters

# Stripe Billing: use live in production and test in development.
# Fill secrets from the matching Stripe account and webhook endpoint.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MCP/OAuth rollout: must match CHATGPT_IMPORT_ENABLED in Next.js.
# Keep disabled until deliberately enabling this deployment's integration.
CHATGPT_IMPORT_ENABLED=false
