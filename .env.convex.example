# Imported into the selected Convex deployment with:
# pnpm convex env set --from-file .env.convex.local --force

# Stripe-hosted Billing. Keep these values only in the selected Convex server
# environment; never copy them to .env.local or a NEXT_PUBLIC_* variable.
STRIPE_SECRET_KEY=replace-with-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-test-webhook-signing-secret
SITE_URL=http://localhost:3000

# Use `fake` for local simulation or `mux` for real Mux development uploads.
MUX_PROVIDER=mux

# Create a Mux Video access token with Read and Write permissions.
MUX_TOKEN_ID=replace-with-mux-token-id
MUX_TOKEN_SECRET=replace-with-mux-token-secret

# Create a Mux signing key. Store the private key as Mux's base64-encoded PEM.
MUX_SIGNING_KEY_ID=replace-with-mux-signing-key-id
MUX_SIGNING_PRIVATE_KEY=replace-with-base64-encoded-private-key

# Generate at least 32 random characters. This must exactly match the value in
# the Next.js environment that receives Mux webhooks.
VIDEO_WEBHOOK_INGEST_SECRET=replace-with-at-least-32-random-characters
